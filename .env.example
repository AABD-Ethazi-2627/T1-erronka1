# Kopiatu "cp .env.example .env" eta bete hutsik dauden balioak.
# .env EZ da git-era igotzen (.gitignore-n dago).

# ── NiFi web UI (https://localhost:8443) ─────────────────────────
NIFI_USERNAME=admin
NIFI_PASSWORD=                  # gutxienez 12 karaktere (NiFi-ren eskakizuna)

# ── Scoring API ──────────────────────────────────────────────────
JWT_SECRET=                     # sortu: openssl rand -hex 32
API_USERNAME=nifi
API_PASSWORD=                   # NiFi-ren OAuth2 zerbitzuan ere sartu behar da

# ── Simuladorearen Samba karpeta (Filebeat-ek CSV-ak irakurtzeko) ─
SMB_IP=192.168.75.150
SMB_USERNAME=cncuser
SMB_PASSWORD=

# Telegram opcional: el servicio telegram-notifier envía las alertas nuevas
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
